// ==============================================================================
// EGOLYTICS R&D MANAGEMENT ENTITIES (MASTER PROMPT 02)
// ==============================================================================

/// EgoLytics R&D Project Intake Proposal
model ProjectProposal {
  id                      String                     @id @default(cuid())
  tenantId                String
  tenant                  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referenceNumber         String
  title                   String
  summary                 String?                    @db.Text
  description             String?                    @db.LongText
  category                String                     @default("Product Innovation")
  problemStatement        String?                    @db.Text
  expectedOutcomes        String?                    @db.Text
  estimatedBudget         Decimal                    @default(0.00) @db.Decimal(12, 2)
  estimatedDurationMonths Int                        @default(6)
  proposedStartDate       DateTime?
  expectedCompletionDate  DateTime?
  submittingUserId        String?
  submittingUser          User?                      @relation("SubmittedProposals", fields: [submittingUserId], references: [id], onDelete: SetNull)
  status                  String                     @default("DRAFT")
  reviewerId              String?
  reviewer                User?                      @relation("ReviewedProposals", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewComments          String?                    @db.Text
  rejectionReason         String?                    @db.Text
  moreInfoNotes           String?                    @db.Text
  convertedProjectId      String?                    @unique
  convertedProject        ErpProject?                @relation("ProposalToProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  strategicGoalId         String?
  strategicGoal           StrategicGoal?             @relation(fields: [strategicGoalId], references: [id], onDelete: SetNull)
  expectedRoi             Float                      @default(50.0)
  riskAssessment          String?                    @default("MEDIUM")
  feasibilityScore        Float                      @default(70.0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([submittingUserId])
  @@index([reviewerId])
  @@index([strategicGoalId])
  @@index([tenantId, referenceNumber])
  @@map("project_proposals")
}

/// EgoLytics Strategic Goal
model StrategicGoal {
  id                String                      @id @default(cuid())
  tenantId          String
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  title             String
  description       String?                     @db.Text
  category          String                      @default("Growth & Innovation")
  targetYear        Int                         @default(2026)
  targetValue       String?
  status            String                      @default("ACTIVE")
  ownerId           String?
  owner             User?                       @relation("OwnedStrategicGoals", fields: [ownerId], references: [id], onDelete: SetNull)
  proposals         ProjectProposal[]
  projectAlignments ProjectStrategicAlignment[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([ownerId])
  @@map("strategic_goals")
}

/// EgoLytics Project to Strategic Goal Alignment
model ProjectStrategicAlignment {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId          String
  project            ErpProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goalId             String
  goal               StrategicGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  alignmentRationale String?       @db.Text
  impactWeight       Float         @default(1.0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([projectId, goalId], map: "unique_project_goal")
  @@index([tenantId])
  @@index([projectId])
  @@index([goalId])
  @@map("project_strategic_alignments")
}

// ==============================================================================
// EGOLYTICS R&D MANAGEMENT ENTITIES (MASTER PROMPT 03: IDEAS & SCORING)
// ==============================================================================

/// EgoLytics Idea Category
model RdIdeaCategory {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?  @db.Text
  color        String?  @default("#3b82f6")
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdById  String?
  createdBy    User?    @relation("CreatedIdeaCategories", fields: [createdById], references: [id], onDelete: SetNull)
  ideas        RdIdea[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name], map: "unique_tenant_idea_category")
  @@index([tenantId])
  @@index([isActive])
  @@map("rd_idea_categories")
}

/// EgoLytics Research Idea Record
model RdIdea {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referenceNumber  String
  title            String
  summary          String?              @db.Text
  problemStatement String?              @db.Text
  proposedSolution String?              @db.Text
  description      String?              @db.LongText
  expectedBenefits String?              @db.Text
  categoryId       String?
  category         RdIdeaCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             String?              @db.Text
  status           String               @default("DRAFT")
  rejectionReason  String?              @db.Text
  moreInfoNotes    String?              @db.Text
  authorId         String?
  author           User?                @relation("AuthoredIdeas", fields: [authorId], references: [id], onDelete: SetNull)
  voteCount        Int                  @default(0)
  evaluationCount  Int                  @default(0)
  compositeScore   Float?
  votes            RdIdeaVote[]
  comments         RdIdeaComment[]
  reviewers        RdIdeaReviewer[]
  evaluations      RdIdeaEvaluation[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([compositeScore])
  @@index([tenantId, referenceNumber])
  @@map("rd_ideas")
}

/// EgoLytics Idea Upvote (1 vote per user per idea)
model RdIdeaVote {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ideaId    String
  idea      RdIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("IdeaVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ideaId, userId], map: "unique_idea_user_vote")
  @@index([tenantId])
  @@index([ideaId])
  @@index([userId])
  @@map("rd_idea_votes")
}

/// EgoLytics Idea Discussion Comment
model RdIdeaComment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ideaId    String
  idea      RdIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("IdeaComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([ideaId])
  @@index([userId])
  @@map("rd_idea_comments")
}

/// EgoLytics Assigned Reviewer for Idea
model RdIdeaReviewer {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ideaId       String
  idea         RdIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User     @relation("AssignedIdeaReviewers", fields: [reviewerId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?    @relation("IdeaReviewerAssigners", fields: [assignedById], references: [id], onDelete: SetNull)
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ideaId, reviewerId], map: "unique_idea_reviewer")
  @@index([tenantId])
  @@index([ideaId])
  @@index([reviewerId])
  @@map("rd_idea_reviewers")
}

/// EgoLytics Evaluation Rubric (Versioned)
model RdIdeaEvaluationRubric {
  id          String                      @id @default(cuid())
  tenantId    String
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  version     Int                         @default(1)
  isActive    Boolean                     @default(true)
  scale       String                      @default("1_TO_5")
  criteria    RdIdeaEvaluationCriterion[]
  evaluations RdIdeaEvaluation[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@index([tenantId])
  @@index([isActive])
  @@map("rd_idea_evaluation_rubrics")
}

/// EgoLytics Evaluation Criterion
model RdIdeaEvaluationCriterion {
  id           String                  @id @default(cuid())
  rubricId     String
  rubric       RdIdeaEvaluationRubric  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name         String
  description  String?                 @db.Text
  weight       Float
  direction    String                  @default("HIGHER_IS_BETTER")
  displayOrder Int                     @default(0)
  scores       RdIdeaEvaluationScore[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([rubricId])
  @@map("rd_idea_evaluation_criteria")
}

/// EgoLytics Idea Evaluation (Evaluator Submission)
model RdIdeaEvaluation {
  id            String                  @id @default(cuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ideaId        String
  idea          RdIdea                  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  evaluatorId   String
  evaluator     User                    @relation("EvaluatorSubmissions", fields: [evaluatorId], references: [id], onDelete: Cascade)
  rubricId      String
  rubric        RdIdeaEvaluationRubric  @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  rubricVersion Int                     @default(1)
  weightedScore Float                   @default(0.0)
  comments      String?                 @db.Text
  status        String                  @default("DRAFT")
  submittedAt   DateTime?
  scores        RdIdeaEvaluationScore[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([ideaId, evaluatorId], map: "unique_idea_evaluator")
  @@index([tenantId])
  @@index([ideaId])
  @@index([evaluatorId])
  @@index([status])
  @@map("rd_idea_evaluations")
}

/// EgoLytics Evaluation Criterion Score
model RdIdeaEvaluationScore {
  id                   String                     @id @default(cuid())
  evaluationId         String
  evaluation           RdIdeaEvaluation           @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionId          String
  criterion            RdIdeaEvaluationCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  rawScore             Float
  normalizedScore      Float
  weight               Float
  weightedContribution Float
  criterionComments    String?                    @db.Text
  createdAt            DateTime                   @default(now())

  @@unique([evaluationId, criterionId], map: "unique_evaluation_criterion")
  @@index([evaluationId])
  @@index([criterionId])
  @@map("rd_idea_evaluation_scores")
}

// ============================================================================
// EGOLYTICS MASTER PROMPT 04 — STAGE-GATE GOVERNANCE & APPROVAL WORKFLOW
// ============================================================================

/// Reusable Stage-Gate Innovation Template
model RdStageTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?  @db.Text
  version     Int      @default(1)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages       RdInnovationStage[]
  governances  RdProjectGovernance[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("rd_stage_templates")
}

/// Individual Innovation Stage within a Template
model RdInnovationStage {
  id                   String   @id @default(cuid())
  tenantId             String
  templateId           String
  name                 String
  code                 String
  stageNumber          Int      @default(1)
  description          String?  @db.Text
  expectedDeliverables String?  @db.Text
  responsibleRole      String?  @default("RD_LEAD")
  color                String   @default("#3b82f6")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      RdStageTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criteria      RdStageCriterion[]
  gate          RdDecisionGate?
  governances   RdProjectGovernance[]   @relation("CurrentStageGovernances")
  reviews       RdGateReview[]
  historiesFrom RdProjectStageHistory[] @relation("HistoryFromStage")
  historiesTo   RdProjectStageHistory[] @relation("HistoryToStage")
  tasks         Task[]                  @relation("StageTasks")

  @@unique([templateId, stageNumber])
  @@index([tenantId, templateId])
  @@map("rd_innovation_stages")
}

/// Stage Entry and Exit Criteria
model RdStageCriterion {
  id               String   @id @default(cuid())
  tenantId         String
  stageId          String
  name             String
  description      String?  @db.Text
  type             String   @default("EXIT") // ENTRY or EXIT
  isMandatory      Boolean  @default(true)
  evidenceRequired Boolean  @default(false)
  sortOrder        Int      @default(1)
  validationRule   String?  @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stage    RdInnovationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  evidence RdGateEvidence[]

  @@index([stageId, type])
  @@map("rd_stage_criteria")
}

/// Decision Gate associated with an Innovation Stage
model RdDecisionGate {
  id                   String   @id @default(cuid())
  tenantId             String
  stageId              String   @unique
  name                 String
  code                 String
  description          String?  @db.Text
  gateOrder            Int      @default(1)
  approvalPolicy       String   @default("ALL_MUST_APPROVE") // ALL_MUST_APPROVE, MINIMUM_COUNT, SINGLE_GATEKEEPER
  requiredSignOffCount Int      @default(1)
  reviewInstructions   String?  @db.Text
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stage       RdInnovationStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  governances RdProjectGovernance[]  @relation("CurrentGateGovernances")
  reviews     RdGateReview[]
  decisions   RdGateDecision[]

  @@index([tenantId])
  @@map("rd_decision_gates")
}

/// Active Governance Instance for an R&D Project
model RdProjectGovernance {
  id                String    @id @default(cuid())
  tenantId          String
  projectId         String    @unique
  templateId        String
  templateVersion   Int       @default(1)
  currentStageId    String?
  currentGateId     String?
  governanceStatus  String    @default("ACTIVE") // ACTIVE, ON_HOLD, REWORK_REQUIRED, TERMINATED, COMPLETED
  holdReason        String?   @db.Text
  terminationReason String?   @db.Text
  originIdeaId      String?
  originProposalId  String?
  startedAt         DateTime  @default(now())
  lastTransitionAt  DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      ErpProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template     RdStageTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  currentStage RdInnovationStage?      @relation("CurrentStageGovernances", fields: [currentStageId], references: [id], onDelete: SetNull)
  currentGate  RdDecisionGate?         @relation("CurrentGateGovernances", fields: [currentGateId], references: [id], onDelete: SetNull)
  reviews      RdGateReview[]
  history      RdProjectStageHistory[]
  decisions    RdGateDecision[]

  @@index([tenantId, governanceStatus])
  @@index([projectId])
  @@map("rd_project_governances")
}

/// Chronological Stage Progression History
model RdProjectStageHistory {
  id                String   @id @default(cuid())
  tenantId          String
  governanceId      String
  projectId         String
  fromStageId       String?
  toStageId         String?
  fromStageName     String?
  toStageName       String?
  triggerGateId     String?
  triggerDecisionId String?
  eventType         String   // INITIALIZED, SUBMITTED_FOR_REVIEW, ADVANCED, HELD, RESUMED, REWORK_REQUESTED, TERMINATED, COMPLETED
  actorId           String?
  actorName         String?
  reason            String?  @db.Text
  notes             String?  @db.Text
  metadata          Json?
  createdAt         DateTime @default(now())

  governance RdProjectGovernance @relation(fields: [governanceId], references: [id], onDelete: Cascade)
  fromStage  RdInnovationStage?  @relation("HistoryFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage    RdInnovationStage?  @relation("HistoryToStage", fields: [toStageId], references: [id], onDelete: SetNull)

  @@index([governanceId])
  @@index([projectId])
  @@index([createdAt])
  @@map("rd_project_stage_histories")
}

/// Formal Gate Review Cycle Instance
model RdGateReview {
  id                     String    @id @default(cuid())
  tenantId               String
  governanceId           String
  projectId              String
  gateId                 String
  stageId                String
  cycleNumber            Int       @default(1)
  status                 String    @default("READY_FOR_REVIEW") // READY_FOR_REVIEW, SUBMITTED, UNDER_REVIEW, MORE_INFO_REQUIRED, APPROVED, REWORK_REQUIRED, ON_HOLD, REJECTED, CANCELLED
  submittedById          String?
  submittedAt            DateTime?
  summary                String?   @db.Text
  notes                  String?   @db.Text
  moreInfoRequestedNotes String?   @db.Text
  moreInfoResponse       String?   @db.Text
  criteriaCompletedCount Int       @default(0)
  criteriaTotalCount     Int       @default(0)
  allCriteriaMet         Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  governance RdProjectGovernance   @relation(fields: [governanceId], references: [id], onDelete: Cascade)
  gate       RdDecisionGate        @relation(fields: [gateId], references: [id], onDelete: Cascade)
  stage      RdInnovationStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  reviewers  RdGateReviewer[]
  signOffs   RdGateSignOff[]
  evidence   RdGateEvidence[]
  decisions  RdGateDecision[]
  comments   RdGateReviewComment[]

  @@index([tenantId, status])
  @@index([governanceId])
  @@index([gateId])
  @@map("rd_gate_reviews")
}

/// Assigned Reviewer or Gatekeeper for a Gate Review
model RdGateReviewer {
  id           String    @id @default(cuid())
  tenantId     String
  reviewId     String
  userId       String
  role         String    @default("GATEKEEPER") // GATEKEEPER, TECHNICAL_REVIEWER, FINANCIAL_REVIEWER, EXECUTIVE
  status       String    @default("PENDING") // PENDING, IN_REVIEW, SIGN_OFF_SUBMITTED
  assignedById String?
  assignedAt   DateTime  @default(now())

  review   RdGateReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewer User         @relation("AssignedGateReviewers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId], map: "unique_gate_review_user")
  @@index([reviewId])
  @@index([userId])
  @@map("rd_gate_reviewers")
}

/// Individual Gatekeeper or Reviewer Formal Sign-Off
model RdGateSignOff {
  id             String   @id @default(cuid())
  tenantId       String
  reviewId       String
  userId         String
  recommendation String   // APPROVE, REJECT, REWORK, HOLD, MORE_INFO
  comments       String?  @db.Text
  signedOffAt    DateTime @default(now())

  review RdGateReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User         @relation("UserGateSignOffs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId], map: "unique_gate_review_signoff_user")
  @@index([reviewId])
  @@index([userId])
  @@map("rd_gate_sign_offs")
}

/// Formal Authoritative Gate Decision Record
model RdGateDecision {
  id               String   @id @default(cuid())
  tenantId         String
  reviewId         String
  governanceId     String
  projectId        String
  gateId           String
  decision         String   // GO_CONTINUE, HOLD, REWORK_RECYCLE, TERMINATE_KILL, REQUEST_MORE_INFO
  decisionReason   String   @db.Text
  decisionComments String?  @db.Text
  decisionMakerId  String
  decidedAt        DateTime @default(now())

  review     RdGateReview        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  governance RdProjectGovernance @relation(fields: [governanceId], references: [id], onDelete: Cascade)
  gate       RdDecisionGate      @relation(fields: [gateId], references: [id], onDelete: Cascade)
  maker      User                @relation("UserGateDecisions", fields: [decisionMakerId], references: [id], onDelete: Cascade)

  @@index([governanceId])
  @@index([reviewId])
  @@index([gateId])
  @@map("rd_gate_decisions")
}

/// Evidence Uploaded or Linked to Gate Reviews and Criteria
model RdGateEvidence {
  id            String   @id @default(cuid())
  tenantId      String
  reviewId      String
  projectId     String
  criterionId   String?
  title         String
  description   String?  @db.Text
  evidenceType  String   @default("DOCUMENT") // DOCUMENT, DATASET, REPORT, URL, EXTERNAL_TEST
  fileUrl       String?
  fileSize      Int?
  uploadedById  String
  uploadedAt    DateTime @default(now())
  status        String   @default("PENDING_REVIEW") // PENDING_REVIEW, ACCEPTED, REJECTED
  reviewerNotes String?  @db.Text

  review    RdGateReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion RdStageCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  uploader  User              @relation("UserGateEvidence", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([projectId])
  @@map("rd_gate_evidence")
}

/// Discussion Comments on Gate Reviews
model RdGateReviewComment {
  id        String   @id @default(cuid())
  tenantId  String
  reviewId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  review RdGateReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User         @relation("UserGateComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("rd_gate_review_comments")
}

// ==============================================================================
// MASTER PROMPT 05: ADVANCED TASK, SPRINT & BACKLOG MANAGEMENT
// ==============================================================================

/// Sprint Iteration Boundary
model RdSprint {
  id            String    @id @default(cuid())
  tenantId      String
  projectId     String?
  name          String
  code          String?
  goal          String?   @db.Text
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED, CANCELLED
  capacityHours Float     @default(0)
  velocity      Float     @default(0)
  completedAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   ErpProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User?       @relation("CreatedSprints", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([projectId])
  @@map("rd_sprints")
}

/// Predecessor-Successor Directed Dependency Edge
model RdTaskDependency {
  id             String   @id @default(cuid())
  tenantId       String
  predecessorId  String
  successorId    String
  dependencyType String   @default("FS") // FS, SS, FF, SF
  lagDays        Int      @default(0)
  createdAt      DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  predecessor Task   @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task   @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([tenantId])
  @@index([predecessorId])
  @@index([successorId])
  @@map("rd_task_dependencies")
}

/// Baseline Schedule Snapshot for Variance & Drift Analysis
model RdTaskScheduleBaseline {
  id                  String    @id @default(cuid())
  tenantId            String
  taskId              String
  projectId           String?
  baselineStartDate   DateTime?
  baselineEndDate     DateTime?
  plannedDurationDays Int       @default(1)
  version             Int       @default(1)
  createdAt           DateTime  @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task    Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project ErpProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([taskId])
  @@index([projectId])
  @@map("rd_task_schedule_baselines")
}

/// Automated Schedule Variance & Blocker Alerts
model RdScheduleAlert {
  id          String    @id @default(cuid())
  tenantId    String
  projectId   String?
  taskId      String?
  alertType   String // OVERDUE, DUE_SOON, CRITICAL_PATH_DELAY, DEPENDENCY_BLOCKED
  severity    String    @default("WARNING") // INFO, WARNING, CRITICAL
  message     String    @db.Text
  status      String    @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project ErpProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([projectId])
  @@index([taskId])
  @@map("rd_schedule_alerts")
}

// ==============================================================================
// MASTER PROMPT 06: DYNAMIC MILESTONES & ROADMAPS
// ==============================================================================

/// Dynamic Project Milestone
model RdMilestone {
  id                    String    @id @default(cuid())
  tenantId              String
  projectId             String
  title                 String
  description           String?   @db.Text
  milestoneCode         String?
  milestoneType         String    @default("DELIVERABLE") // DELIVERABLE, STAGE_GATE, REVIEW, DECISION, RELEASE
  plannedStartDate      DateTime?
  plannedEndDate        DateTime?
  actualStartDate       DateTime?
  actualCompletionDate  DateTime?
  status                String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, DELAYED, ON_HOLD, CANCELLED
  progress              Int       @default(0) // 0-100%
  priority              String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  ownerId               String?
  sortOrder             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?      @relation("OwnedMilestones", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks   Task[]     @relation("MilestoneTasks")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([projectId])
  @@map("rd_milestones")
}

// ==============================================================================
// MASTER PROMPT 07: RESEARCH HYPOTHESIS & EXPERIMENT MANAGEMENT
// ==============================================================================

model RdResearchObjective {
  id               String       @id @default(cuid())
  tenantId         String
  projectId        String
  title            String
  description      String?      @db.Text
  researchQuestion String?      @db.Text
  category         String       @default("APPLIED_RESEARCH")
  priority         String       @default("MEDIUM")
  status           String       @default("ACTIVE") // DRAFT, ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  ownerId          String?
  startDate        DateTime?
  targetDate       DateTime?
  completionDate   DateTime?
  successCriteria  String?      @db.Text
  progress         Int          @default(0) // 0-100%
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     ErpProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?                @relation("OwnedObjectives", fields: [ownerId], references: [id], onDelete: SetNull)
  hypotheses  RdHypothesis[]
  experiments RdExperiment[]
  evidences   RdResearchEvidence[]
  outcomes    RdResearchOutcome[]

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([ownerId])
  @@map("rd_research_objectives")
}

model RdHypothesis {
  id                    String                @id @default(cuid())
  tenantId              String
  projectId             String
  objectiveId           String?
  hypothesisCode        String?
  title                 String
  statement             String                @db.Text
  description           String?               @db.Text
  scientificRationale   String?               @db.Text
  expectedOutcome       String?               @db.Text
  hypothesisType        String                @default("ALTERNATIVE_HYPOTHESIS") // NULL_HYPOTHESIS, ALTERNATIVE_HYPOTHESIS, DIRECTIONAL_HYPOTHESIS, NON_DIRECTIONAL_HYPOTHESIS
  priority              String                @default("MEDIUM")
  status                String                @default("PROPOSED") // DRAFT, PROPOSED, UNDER_TESTING, SUPPORTED, NOT_SUPPORTED, INCONCLUSIVE, ARCHIVED
  evaluationDecision    String?               // SUPPORTED, NOT_SUPPORTED, INCONCLUSIVE
  evaluationSummary     String?               @db.Text
  supportingEvidence    String?               @db.Text
  contradictoryEvidence String?               @db.Text
  conclusion            String?               @db.Text
  evaluatedById         String?
  evaluationDate        DateTime?
  ownerId               String?
  createdById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     ErpProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objective   RdResearchObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  owner       User?                @relation("OwnedHypotheses", fields: [ownerId], references: [id], onDelete: SetNull)
  experiments RdExperiment[]
  evidences   RdResearchEvidence[]
  outcomes    RdResearchOutcome[]

  @@index([tenantId])
  @@index([projectId])
  @@index([objectiveId])
  @@index([status])
  @@map("rd_hypotheses")
}

model RdVariable {
  id                String    @id @default(cuid())
  tenantId          String
  projectId         String?
  name              String
  description       String?   @db.Text
  variableType      String    @default("INDEPENDENT") // INDEPENDENT, DEPENDENT, CONTROLLED, CONTEXTUAL
  dataType          String    @default("DECIMAL")     // INTEGER, DECIMAL, TEXT, BOOLEAN, DATE, DATETIME, ENUM
  unit              String?
  measurementMethod String?
  expectedValue     String?
  minValue          Float?    @map("minValue")
  maxValue          Float?    @map("maxValue")
  allowedValues     Json?
  isRequired        Boolean   @default(true)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([variableType])
  @@map("rd_variables")
}

model RdExperimentProtocol {
  id                       String           @id @default(cuid())
  tenantId                 String
  projectId                String?
  protocolCode             String?
  title                    String
  description              String?          @db.Text
  purpose                  String?          @db.Text
  methodology              String?          @db.Text
  requiredMaterials        String?          @db.Text
  equipmentDescription     String?          @db.Text
  safetyInstructions       String?          @db.Text
  expectedObservations     String?          @db.Text
  expectedResults          String?          @db.Text
  estimatedDurationMinutes Int?
  version                  Int              @default(1)
  status                   String           @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  isTemplate               Boolean          @default(false)
  ownerId                  String?
  createdById              String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User?            @relation("OwnedProtocols", fields: [ownerId], references: [id], onDelete: SetNull)
  steps       RdProtocolStep[]
  experiments RdExperiment[]

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([isTemplate])
  @@map("rd_experiment_protocols")
}

model RdProtocolStep {
  id                  String               @id @default(cuid())
  tenantId            String
  protocolId          String
  stepNumber          Int
  title               String
  instructions        String               @db.Text
  expectedAction      String?              @db.Text
  expectedObservation String?              @db.Text
  durationMinutes     Int?
  isRequired          Boolean              @default(true)
  notes               String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  protocol RdExperimentProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([protocolId])
  @@index([stepNumber])
  @@map("rd_protocol_steps")
}

model RdExperiment {
  id                     String                @id @default(cuid())
  tenantId               String
  projectId              String
  objectiveId            String?
  hypothesisId           String?
  protocolId             String?
  experimentCode         String?
  title                  String
  description            String?               @db.Text
  purpose                String?               @db.Text
  experimentType         String                @default("LABORATORY") // LABORATORY, FIELD, SIMULATION, ANALYTICAL, PROTOTYPE_TEST, OTHER
  priority               String                @default("MEDIUM")
  status                 String                @default("PLANNED") // PLANNED, READY, IN_PROGRESS, PAUSED, COMPLETED, FAILED, CANCELLED
  plannedStartDate       DateTime?
  plannedEndDate         DateTime?
  actualStartDate        DateTime?
  actualEndDate          DateTime?
  ownerId                String?
  assignedResearcherIds  Json?
  experimentalConditions Json?
  expectedOutcomes       String?               @db.Text
  successCriteria        String?               @db.Text
  taskId                 String?
  milestoneId            String?
  createdById            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    ErpProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objective  RdResearchObjective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  hypothesis RdHypothesis?         @relation(fields: [hypothesisId], references: [id], onDelete: SetNull)
  protocol   RdExperimentProtocol? @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  owner      User?                 @relation("OwnedExperiments", fields: [ownerId], references: [id], onDelete: SetNull)
  task       Task?                 @relation("TaskExperiments", fields: [taskId], references: [id], onDelete: SetNull)
  runs       RdExperimentRun[]
  results    RdExperimentResult[]
  evidences  RdResearchEvidence[]

  // Master Prompt 10 Relations
  timeEntries      RdTimeEntry[]
  facilityBookings RdFacilityBooking[]

  @@index([tenantId])
  @@index([projectId])
  @@index([objectiveId])
  @@index([hypothesisId])
  @@index([protocolId])
  @@index([status])
  @@map("rd_experiments")
}

model RdExperimentRun {
  id                 String                     @id @default(cuid())
  tenantId           String
  experimentId       String
  runNumber          Int
  runCode            String?
  title              String?
  status             String                     @default("PLANNED") // PLANNED, READY, IN_PROGRESS, PAUSED, COMPLETED, FAILED, CANCELLED
  protocolVersion    Int                        @default(1)
  protocolSnapshot   Json?
  conditionsSnapshot Json?
  operatorId         String?
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?                    @db.Text
  createdById        String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  experiment   RdExperiment              @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  runSteps     RdExperimentRunStep[]
  observations RdExperimentObservation[]
  measurements RdExperimentMeasurement[]
  results      RdExperimentResult[]
  evidences    RdResearchEvidence[]

  @@index([tenantId])
  @@index([experimentId])
  @@index([status])
  @@index([runNumber])
  @@map("rd_experiment_runs")
}

model RdExperimentRunStep {
  id            String          @id @default(cuid())
  tenantId      String
  runId         String
  stepNumber    Int
  title         String
  isCompleted   Boolean         @default(false)
  completedAt   DateTime?
  completedById String?
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    RdExperimentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([runId])
  @@index([stepNumber])
  @@map("rd_experiment_run_steps")
}

model RdExperimentObservation {
  id              String          @id @default(cuid())
  tenantId        String
  runId           String
  title           String
  description     String          @db.Text
  observationType String          @default("GENERAL") // GENERAL, VISUAL, ANOMALY, PROCEDURE_DEVIATION, BENCH_NOTE
  observedAt      DateTime        @default(now())
  recordedById    String?
  stepNumber      Int?
