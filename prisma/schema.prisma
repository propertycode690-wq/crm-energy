  title                  String
  description            String?             @db.Text
  category               String              @default("ARCHITECTURE") // ARCHITECTURE, TECHNICAL, STRATEGIC, SCOPE, GOVERNANCE, PROCESS, QUALITY, RESOURCE, BUDGET, COMPLIANCE
  rationale              String              @db.Text
  alternativesConsidered String?             @db.Text
  tradeOffs              String?             @db.Text
  impactSummary          String?             @db.Text
  status                 String              @default("PROPOSED") // DRAFT, PROPOSED, UNDER_REVIEW, APPROVED, REJECTED, SUPERSEDED
  decisionMakerId        String?
  decisionMakerName      String?
  decisionDate           DateTime?
  effectiveDate          DateTime?
  reviewDate             DateTime?
  linkedGateId           String?
  linkedStageId          String?
  linkedTaskId           String?
  createdById            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project                ErpProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  histories              RdDecisionHistory[]

  @@unique([tenantId, decisionCode])
  @@index([tenantId])
  @@index([projectId])
  @@index([category])
  @@index([status])
  @@map("rd_decisions")
}

