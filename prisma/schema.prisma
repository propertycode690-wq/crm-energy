  description         String?                  @db.Text
  category            String                   @default("FUNCTIONAL") // FUNCTIONAL, NON_FUNCTIONAL, PERFORMANCE, COMPLIANCE, SAFETY, USABILITY, SCIENTIFIC, REGULATORY
  priority            String                   @default("HIGH") // MUST_HAVE, SHOULD_HAVE, COULD_HAVE, WONT_HAVE_THIS_TIME
  verificationMethod  String                   @default("TEST") // TEST, DEMONSTRATION, INSPECTION, ANALYSIS, SIMULATION
  verificationStatus  String                   @default("UNVERIFIED") // UNVERIFIED, VERIFICATION_IN_PROGRESS, PASSED, FAILED, WAIVED
  complianceStatus    String                   @default("NON_COMPLIANT") // COMPLIANT, PARTIAL, NON_COMPLIANT, UNDER_EVALUATION
  source              String?
  version             String                   @default("1.0")
  ownerId             String?
  ownerName           String?
  linkedExperimentId  String?
  linkedTaskId        String?
  linkedDeliverableId String?
  createdById         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             ErpProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criteria            RdRequirementCriterion[]

  @@unique([tenantId, reqCode])
  @@index([tenantId])
  @@index([projectId])
  @@index([category])
  @@index([priority])
  @@index([verificationStatus])
  @@map("rd_requirements")
}

