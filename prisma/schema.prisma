  @@index([tenantId])
  @@index([decisionId])
  @@map("rd_decision_histories")
}

model RdRisk {
  id                  String                 @id @default(cuid())
  tenantId            String
  projectId           String
  riskCode            String
  title               String
  description         String?                @db.Text
  category            String                 @default("TECHNICAL") // TECHNICAL, SCHEDULE, BUDGET, RESOURCE, REGULATORY, SCIENTIFIC, OPERATIONAL, EXTERNAL, MARKET
  probability         Int                    @default(3) // 1 - 5
  impact              Int                    @default(3) // 1 - 5
  riskScore           Int                    @default(9) // probability * impact (1 - 25)
  riskLevel           String                 @default("MODERATE") // LOW (1-4), MODERATE (5-9), HIGH (10-16), CRITICAL (17-25)
  status              String                 @default("IDENTIFIED") // IDENTIFIED, ASSESSED, MITIGATION_PLANNED, MITIGATION_ACTIVE, MONITORING, RETIRED, MATERIALIZED
  strategy            String                 @default("MITIGATE") // MITIGATE, AVOID, TRANSFER, ACCEPT
  ownerId             String?
  ownerName           String?
  contingencyPlan     String?                @db.Text
  triggerCondition    String?                @db.Text
  residualProbability Int?
  residualImpact      Int?
  residualScore       Int?
  reviewFrequency     String                 @default("MONTHLY") // WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, STAGE_GATE
  lastReviewedAt      DateTime?
  nextReviewDate      DateTime?
  linkedTaskId        String?
  linkedMilestoneId   String?
  linkedGateId        String?
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             ErpProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mitigations         RdRiskMitigation[]
  reviewHistories     RdRiskReviewHistory[]

  @@unique([tenantId, riskCode])
  @@index([tenantId])
  @@index([projectId])
  @@index([category])
  @@index([riskLevel])
  @@index([status])
  @@map("rd_risks")
}

model RdRiskMitigation {
  id                String    @id @default(cuid())
  tenantId          String
  riskId            String
  actionTitle       String
  actionDescription String?   @db.Text
  ownerId           String?
  ownerName         String?
